<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Resources/app.ico</ApplicationIcon>
    
    <!-- Publicação como Standalone .EXE -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>../../dist/OpenTURZXStudio-v1.0.0</PublishDir>
    
    <!-- Informações da Versão -->
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <ProductVersion>1.0.0.0</ProductVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <AssemblyName>OpenTURZXStudio.Desktop</AssemblyName>
    <Product>OpenTURZXStudio</Product>
    <Company>blackshals-tech</Company>
    <Description>Aplicação Desktop Profissional para Gerenciamento de Dispositivos TURZX</Description>
    <Copyright>Copyright © 2026 blackshals-tech</Copyright>
    
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTURZXStudio.Core\OpenTURZXStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="4.8.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources" />
  </ItemGroup>
</Project>