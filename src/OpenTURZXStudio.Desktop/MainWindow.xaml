<Window x:Class="OpenTURZXStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="OpenTURZXStudio" Height="700" Width="1200"
        Background="{StaticResource PrimaryBrush}"
        Foreground="White"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}" Padding="16" BorderThickness="0,0,0,1" BorderBrush="#3D3D3D">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◆" FontSize="24" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="OpenTURZXStudio" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Configurações">
                        <materialDesign:PackIcon Kind="Cog" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Ajuda">
                        <materialDesign:PackIcon Kind="HelpCircle" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <TabControl Grid.Row="1" Background="{StaticResource PrimaryBrush}" Foreground="White">
            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard" Foreground="White">
                <Border Background="{StaticResource PrimaryBrush}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Status Cards -->
                        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource SecondaryBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="Conexão" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="12" Height="12" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Desconectado" VerticalAlignment="Center" Foreground="#999"/>
                                </StackPanel>
                                <Button Content="Conectar" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource AccentBrush}" Width="120" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource SecondaryBrush}" CornerRadius="8" Padding="16" Margin="4,0,4,8">
                            <StackPanel>
                                <TextBlock Text="Dispositivos" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Portas seriais detectadas" FontSize="12" Foreground="#999"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource SecondaryBrush}" CornerRadius="8" Padding="16" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Transferências" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Arquivos enviados" FontSize="12" Foreground="#999"/>
                            </StackPanel>
                        </Border>

                        <!-- Main Content Area -->
                        <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource SecondaryBrush}" CornerRadius="8" Padding="16" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- File Browser -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Arquivos" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <ListBox Background="{StaticResource PrimaryBrush}" Foreground="#CCC" Height="300" ItemsSource="{x:Static local:MainWindow.SampleFiles}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8" BorderThickness="0,0,0,1" BorderBrush="#3D3D3D">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🖼️" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Content="+ Adicionar Arquivo" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource AccentBrush}" Margin="0,12,0,0" Height="40"/>
                                </StackPanel>

                                <!-- Preview -->
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Visualização" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <Border Background="{StaticResource PrimaryBrush}" Height="300" CornerRadius="8" BorderThickness="1" BorderBrush="#3D3D3D">
                                        <Grid>
                                            <TextBlock Text="Nenhum arquivo selecionado" Foreground="#666" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Button Content="Enviar" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4CAF50" Margin="0,12,0,0" Height="40"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Devices Tab -->
            <TabItem Header="Dispositivos" Foreground="White">
                <Border Background="{StaticResource PrimaryBrush}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Gerenciador de Dispositivos" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                        
                        <Border Background="{StaticResource SecondaryBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Portas Seriais Disponíveis" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                <ListBox Background="{StaticResource PrimaryBrush}" Foreground="#CCC" Height="150" ItemsSource="{x:Static local:MainWindow.SamplePorts}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8" BorderThickness="0,0,0,1" BorderBrush="#3D3D3D">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔌" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Spacing="8">
                                    <Button Content="Atualizar" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource AccentBrush}" Height="36"/>
                                    <Button Content="Conectar" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4CAF50" Height="36"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SecondaryBrush}" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Dispositivos USB" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                <ListBox Background="{StaticResource PrimaryBrush}" Foreground="#CCC" Height="150" ItemsSource="{x:Static local:MainWindow.SampleUsbDevices}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8" BorderThickness="0,0,0,1" BorderBrush="#3D3D3D">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💾" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- GIF Player Tab -->
            <TabItem Header="GIF Player" Foreground="White">
                <Border Background="{StaticResource PrimaryBrush}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Reprodutor de GIF" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                        
                        <Border Background="{StaticResource SecondaryBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Border Background="{StaticResource PrimaryBrush}" Height="400" CornerRadius="8" BorderThickness="1" BorderBrush="#3D3D3D" Margin="0,0,0,16">
                                    <Grid>
                                        <Image Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="Nenhum GIF carregado" Foreground="#666" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" FontSize="16"/>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                                    <Button Content="⏮ Primeiro" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource AccentBrush}" Height="40" Width="100"/>
                                    <Button Content="⏪ Anterior" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource AccentBrush}" Height="40" Width="100"/>
                                    <Button Content="⏸ Pausar" Style="{StaticResource MaterialDesignRaisedButton}" Background="#FF9800" Height="40" Width="100"/>
                                    <Button Content="Próximo ⏩" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource AccentBrush}" Height="40" Width="100"/>
                                    <Button Content="Último ⏭" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource AccentBrush}" Height="40" Width="100"/>
                                </StackPanel>

                                <ProgressBar Height="6" Background="#3D3D3D" Foreground="{StaticResource AccentBrush}" Value="0" Margin="0,0,0,8"/>
                                <TextBlock Text="Frame: 0 / 0" Foreground="#999" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SecondaryBrush}" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Carregar GIF" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                <Button Content="📂 Selecionar arquivo" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource AccentBrush}" Height="40"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Logs Tab -->
            <TabItem Header="Logs" Foreground="White">
                <Border Background="{StaticResource PrimaryBrush}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Log de Aplicação" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                            <Button Content="Limpar" Style="{StaticResource MaterialDesignRaisedButton}" Background="#F44336" Height="36"/>
                            <Button Content="Exportar" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource AccentBrush}" Height="36"/>
                        </StackPanel>

                        <TextBox Background="{StaticResource SecondaryBrush}" Foreground="#CCC" Height="500" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" Margin="0,0,0,12">
[INFO] Aplicação iniciada
[INFO] Detectadas 2 portas seriais: COM3, COM4
[DEBUG] Logger inicializado com sucesso
[INFO] Aguardando conexão com dispositivo...
                        </TextBox>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>